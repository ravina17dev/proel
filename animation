
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Animated SVG Ice Cream</title>

<style>
    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fff0f5;
        font-family: Arial, sans-serif;
    }

    .container {
        text-align: center;
    }

    svg {
        width: 300px;
        height: 300px;
        background: #fffaf5;
        border-radius: 20px;
    }

    .ice-cream {
        transform-origin: 150px 245px;
        animation: bounce 2s ease-in-out infinite;
    }

    .scoop {
        transform-origin: 150px 135px;
        animation: wobble 2s ease-in-out infinite;
    }

    .sprinkles {
        animation: sparkle 2s ease-in-out infinite;
    }

    .shine {
        animation: shine 2s ease-in-out infinite alternate;
    }

    @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    @keyframes wobble {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-3deg); }
        75% { transform: rotate(3deg); }
    }

    @keyframes sparkle {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.45; }
    }

    @keyframes shine {
        from { opacity: 0.4; }
        to { opacity: 1; }
    }
</style>
</head>

<body>

<div class="container">

<svg viewBox="0 0 300 300"
     width="300" height="300"
     xmlns="http://www.w3.org/2000/svg"
     role="img" aria-label="Animated pink ice cream cone">

    <defs>
        <linearGradient id="coneGradient"
                        x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#f8c878"/>
            <stop offset="100%" stop-color="#c77b3c"/>
        </linearGradient>

        <linearGradient id="scoopGradient"
                        x1="0" y1="0" x2="0.8" y2="1">
            <stop offset="0%" stop-color="#ffb9d2"/>
            <stop offset="100%" stop-color="#f16f9f"/>
        </linearGradient>
    </defs>

    <!-- Background decoration -->
    <circle cx="150" cy="145" r="115" fill="#fff0f5"/>

    <g fill="#ffd166">
        <path d="M48 65 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5Z"/>
        <path d="M248 88 l4 9 9 4 -9 4 -4 9 -4 -9 -9 -4 9 -4Z"/>
        <circle cx="58" cy="195" r="4"/>
        <circle cx="243" cy="190" r="5"/>
    </g>

    <g class="ice-cream">

        <!-- Cone -->
        <path d="M104 157 L150 266 L196 157 Z"
              fill="url(#coneGradient)"
              stroke="#b96f37"
              stroke-width="2"
              stroke-linejoin="round"/>

        <!-- Waffle pattern -->
        <g stroke="#b96f37"
           stroke-width="2"
           opacity="0.75">
            <path d="M115 180 L181 180"/>
            <path d="M122 197 L178 197"/>
            <path d="M130 216 L170 216"/>
            <path d="M137 235 L163 235"/>
            <path d="M118 166 L160 250"/>
            <path d="M140 160 L181 242"/>
            <path d="M180 166 L140 250"/>
            <path d="M160 160 L122 242"/>
        </g>

        <!-- Ice cream scoop -->
        <g class="scoop">
            <path d="M91 151
                     C76 140 78 119 90 106
                     C91 79 116 63 139 72
                     C157 57 183 69 190 87
                     C214 94 225 117 211 139
                     C205 151 194 157 180 158
                     L112 158
                     C103 158 96 156 91 151Z"
                  fill="url(#scoopGradient)"
                  stroke="#e65e91"
                  stroke-width="2"/>

            <!-- Scoop shine -->
            <ellipse class="shine"
                     cx="119" cy="96"
                     rx="17" ry="9"
                     fill="#fff0f5"
                     transform="rotate(-35 119 96)"/>

            <!-- Sprinkles -->
            <g class="sprinkles"
               stroke-linecap="round"
               stroke-width="5">
                <path d="M107 116 L115 111"
                      stroke="#fff176"/>
                <path d="M139 91 L145 99"
                      stroke="#6ddccf"/>
                <path d="M166 83 L171 91"
                      stroke="#ffffff"/>
                <path d="M186 111 L195 107"
                      stroke="#a78bfa"/>
                <path d="M126 133 L133 126"
                      stroke="#ffffff"/>
                <path d="M165 131 L172 136"
                      stroke="#ffd166"/>
                <path d="M193 137 L199 131"
                      stroke="#62c8a5"/>
                <path d="M91 132 L98 135"
                      stroke="#ffd166"/>
            </g>
        </g>

        <!-- Cone tip -->
        <path d="M139 240 L150 266 L161 240"
              fill="none"
              stroke="#a85f32"
              stroke-width="2"
              opacity="0.5"/>

    </g>

    <!-- Bottom caption -->
    <text x="150" y="287"
          text-anchor="middle"
          font-family="Arial, sans-serif"
          font-size="12"
          font-weight="bold"
          letter-spacing="2"
          fill="#d95d8a">SWEET TREAT</text>

</svg>

</div>

</body>
</html>
