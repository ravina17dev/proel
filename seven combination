
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Seven SVG Graphic Arts</title>

<style>
    body {
        margin: 0;
        padding: 20px;
        font-family: Arial, sans-serif;
        text-align: center;
        background: #eaf3ff;
        color: #294b78;
    }

    h1 {
        color: #315f9c;
    }

    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 18px;
        max-width: 900px;
        margin: 20px auto;
        justify-items: center;
    }

    .art {
        background: white;
        padding: 8px;
        border: 2px solid #91b9ed;
        border-radius: 8px;
        width: 200px;
    }

    svg {
        display: block;
        width: 200px;
        height: 300px;
    }

    h3 {
        font-size: 14px;
        color: #315f9c;
    }
</style>
</head>

<body>

<h1>SVG GRAPHICAL ARTS</h1>
<p>Seven artworks using SVG elements in blue and pink shades</p>

<div class="gallery">

<!-- 1. LINE AND CIRCLE -->
<div class="art">
<svg width="200" height="300" viewBox="0 0 200 300"
     xmlns="http://www.w3.org/2000/svg">
    <rect width="200" height="300" fill="#f8fbff"/>

    <g stroke="#6495d9" stroke-width="3">
        <line x1="20" y1="45" x2="180" y2="45"/>
        <line x1="20" y1="105" x2="180" y2="105"/>
        <line x1="20" y1="165" x2="180" y2="165"/>
        <line x1="20" y1="225" x2="180" y2="225"/>
        <line x1="20" y1="275" x2="180" y2="275"/>
        <line x1="40" y1="20" x2="40" y2="280"/>
        <line x1="100" y1="20" x2="100" y2="280"/>
        <line x1="160" y1="20" x2="160" y2="280"/>
    </g>

    <g fill="#f28eae" stroke="#d85f8a" stroke-width="2">
        <circle cx="40" cy="45" r="18"/>
        <circle cx="100" cy="105" r="18"/>
        <circle cx="160" cy="165" r="18"/>
        <circle cx="40" cy="225" r="18"/>
        <circle cx="100" cy="275" r="12"/>
    </g>

    <g fill="#6db8e8">
        <circle cx="40" cy="45" r="7"/>
        <circle cx="100" cy="105" r="7"/>
        <circle cx="160" cy="165" r="7"/>
        <circle cx="40" cy="225" r="7"/>
    </g>
</svg>
<h3>1. Line and Circle</h3>
</div>


<!-- 2. CIRCLE AND RECTANGLE -->
<div class="art">
<svg width="200" height="300" viewBox="0 0 200 300"
     xmlns="http://www.w3.org/2000/svg">
    <rect width="200" height="300" fill="#d9efff"/>

    <rect x="15" y="15" width="170" height="80"
          rx="8" fill="#4c8ed9"/>
    <rect x="15" y="110" width="170" height="80"
          rx="8" fill="#f28eae"/>
    <rect x="15" y="205" width="170" height="80"
          rx="8" fill="#6495d9"/>

    <g fill="#ffd5e3">
        <circle cx="40" cy="40" r="10"/>
        <circle cx="80" cy="40" r="10"/>
        <circle cx="120" cy="40" r="10"/>
        <circle cx="160" cy="40" r="10"/>
        <circle cx="60" cy="70" r="10"/>
        <circle cx="100" cy="70" r="10"/>
        <circle cx="140" cy="70" r="10"/>
    </g>

    <g fill="#315f9c">
        <circle cx="40" cy="135" r="10"/>
        <circle cx="80" cy="135" r="10"/>
        <circle cx="120" cy="135" r="10"/>
        <circle cx="160" cy="135" r="10"/>
        <circle cx="60" cy="165" r="10"/>
        <circle cx="100" cy="165" r="10"/>
        <circle cx="140" cy="165" r="10"/>
    </g>

    <g fill="#f28eae">
        <circle cx="40" cy="230" r="10"/>
        <circle cx="80" cy="230" r="10"/>
        <circle cx="120" cy="230" r="10"/>
        <circle cx="160" cy="230" r="10"/>
        <circle cx="60" cy="260" r="10"/>
        <circle cx="100" cy="260" r="10"/>
        <circle cx="140" cy="260" r="10"/>
    </g>
</svg>
<h3>2. Circle and Rectangle</h3>
</div>


<!-- 3. POLYLINE AND CIRCLE -->
<div class="art">
<svg width="200" height="300" viewBox="0 0 200 300"
     xmlns="http://www.w3.org/2000/svg">
    <rect width="200" height="300" fill="#f8fbff"/>

    <g fill="none" stroke-width="9" stroke-linejoin="round">
        <polyline points="0,35 25,10 50,35 75,10 100,35 125,10 150,35 175,10 200,35"
                  stroke="#f28eae"/>
        <polyline points="0,95 25,70 50,95 75,70 100,95 125,70 150,95 175,70 200,95"
                  stroke="#6495d9"/>
        <polyline points="0,155 25,130 50,155 75,130 100,155 125,130 150,155 175,130 200,155"
                  stroke="#f28eae"/>
        <polyline points="0,215 25,190 50,215 75,190 100,215 125,190 150,215 175,190 200,215"
                  stroke="#6495d9"/>
        <polyline points="0,275 25,250 50,275 75,250 100,275 125,250 150,275 175,250 200,275"
                  stroke="#f28eae"/>
    </g>

    <g fill="#315f9c" stroke="#ffffff" stroke-width="2">
        <circle cx="25" cy="48" r="10"/>
        <circle cx="75" cy="48" r="10"/>
        <circle cx="125" cy="48" r="10"/>
        <circle cx="175" cy="48" r="10"/>

        <circle cx="50" cy="108" r="10"/>
        <circle cx="100" cy="108" r="10"/>
        <circle cx="150" cy="108" r="10"/>

        <circle cx="25" cy="168" r="10"/>
        <circle cx="75" cy="168" r="10"/>
        <circle cx="125" cy="168" r="10"/>
        <circle cx="175" cy="168" r="10"/>

        <circle cx="50" cy="228" r="10"/>
        <circle cx="100" cy="228" r="10"/>
        <circle cx="150" cy="228" r="10"/>
    </g>
</svg>
<h3>3. Polyline and Circle</h3>
</div>


<!-- 4. POLYGON AND ELLIPSE -->
<div class="art">
<svg width="200" height="300" viewBox="0 0 200 300"
     xmlns="http://www.w3.org/2000/svg">
    <rect width="200" height="300" fill="#fff7fa"/>

    <g fill="#6495d9">
        <polygon points="0,15 25,40 50,15 75,40 100,15 125,40 150,15 175,40 200,15 200,55 175,30 150,55 125,30 100,55 75,30 50,55 25,30 0,55"/>
        <polygon points="0,100 25,125 50,100 75,125 100,100 125,125 150,100 175,125 200,100 200,140 175,115 150,140 125,115 100,140 75,115 50,140 25,115 0,140"/>
        <polygon points="0,185 25,210 50,185 75,210 100,185 125,210 150,185 175,210 200,185 200,225 175,200 150,225 125,200 100,225 75,200 50,225 25,200 0,225"/>
        <polygon points="0,270 25,295 50,270 75,295 100,270 125,295 150,270 175,295 200,270 200,300 0,300"/>
    </g>

    <g fill="#f28eae">
        <ellipse cx="25" cy="75" rx="12" ry="22"/>
        <ellipse cx="75" cy="75" rx="12" ry="22"/>
        <ellipse cx="125" cy="75" rx="12" ry="22"/>
        <ellipse cx="175" cy="75" rx="12" ry="22"/>

        <ellipse cx="50" cy="160" rx="12" ry="22"/>
        <ellipse cx="100" cy="160" rx="12" ry="22"/>
        <ellipse cx="150" cy="160" rx="12" ry="22"/>

        <ellipse cx="25" cy="245" rx="12" ry="22"/>
        <ellipse cx="75" cy="245" rx="12" ry="22"/>
        <ellipse cx="125" cy="245" rx="12" ry="22"/>
        <ellipse cx="175" cy="245" rx="12" ry="22"/>
    </g>
</svg>
<h3>4. Polygon and Ellipse</h3>
</div>


<!-- 5. CIRCLE, LINE AND RECTANGLE -->
<div class="art">
<svg width="200" height="300" viewBox="0 0 200 300"
     xmlns="http://www.w3.org/2000/svg">
    <rect width="200" height="300" fill="#e7f4ff"/>

    <g fill="#f28eae">
        <rect x="25" y="25" width="150" height="50" rx="6"/>
        <rect x="25" y="125" width="150" height="50" rx="6"/>
        <rect x="25" y="225" width="150" height="50" rx="6"/>
    </g>

    <g stroke="#315f9c" stroke-width="4">
        <line x1="20" y1="100" x2="180" y2="100"/>
        <line x1="20" y1="200" x2="180" y2="200"/>
    </g>

    <g fill="#ffffff" stroke="#6495d9" stroke-width="3">
        <circle cx="50" cy="50" r="15"/>
        <circle cx="100" cy="50" r="15"/>
        <circle cx="150" cy="50" r="15"/>

        <circle cx="50" cy="150" r="15"/>
        <circle cx="100" cy="150" r="15"/>
        <circle cx="150" cy="150" r="15"/>

        <circle cx="50" cy="250" r="15"/>
        <circle cx="100" cy="250" r="15"/>
        <circle cx="150" cy="250" r="15"/>
    </g>
</svg>
<h3>5. Circle, Line and Rectangle</h3>
</div>


<!-- 6. POLYLINE AND POLYGON -->
<div class="art">
<svg width="200" height="300" viewBox="0 0 200 300"
     xmlns="http://www.w3.org/2000/svg">
    <rect width="200" height="300" fill="#f8fbff"/>

    <g fill="#f28eae">
        <polygon points="10,20 55,20 85,50 55,80 10,80 40,50"/>
        <polygon points="90,20 135,20 165,50 135,80 90,80 120,50"/>

        <polygon points="10,110 55,110 85,140 55,170 10,170 40,140"/>
        <polygon points="90,110 135,110 165,140 135,170 90,170 120,140"/>

        <polygon points="10,200 55,200 85,230 55,260 10,260 40,230"/>
        <polygon points="90,200 135,200 165,230 135,260 90,260 120,230"/>
    </g>

    <g fill="none" stroke="#6495d9"
       stroke-width="6" stroke-linejoin="round">
        <polyline points="10,95 40,85 70,95 100,85 130,95 160,85 190,95"/>
        <polyline points="10,185 40,175 70,185 100,175 130,185 160,175 190,185"/>
        <polyline points="10,275 40,265 70,275 100,265 130,275 160,265 190,275"/>
    </g>
</svg>
<h3>6. Polyline and Polygon</h3>
</div>


<!-- 7. ALL FIVE ELEMENTS -->
<div class="art">
<svg width="200" height="300" viewBox="0 0 200 300"
     xmlns="http://www.w3.org/2000/svg">
    <rect width="200" height="300" fill="#e7f4ff"/>

    <!-- Rectangles -->
    <rect x="15" y="20" width="170" height="260"
          rx="8" fill="#f8fbff"
          stroke="#6495d9" stroke-width="3"/>

    <rect x="30" y="35" width="140" height="230"
          rx="6" fill="#fbd5e3"/>

    <!-- Polylines -->
    <g fill="none" stroke="#315f9c" stroke-width="5">
        <polyline points="30,75 65,45 100,75 135,45 170,75"/>
        <polyline points="30,225 65,195 100,225 135,195 170,225"/>
    </g>

    <!-- Polygons -->
    <g fill="#6495d9">
        <polygon points="45,95 100,75 155,95 100,115"/>
        <polygon points="45,205 100,185 155,205 100,225"/>
    </g>

    <!-- Ellipses -->
    <g fill="#f28eae">
        <ellipse cx="65" cy="145" rx="15" ry="23"/>
        <ellipse cx="135" cy="145" rx="15" ry="23"/>
    </g>

    <!-- Circles -->
    <g fill="#315f9c" stroke="#ffffff" stroke-width="2">
        <circle cx="100" cy="145" r="20"/>
        <circle cx="45" cy="165" r="7"/>
        <circle cx="155" cy="165" r="7"/>
    </g>

    <circle cx="100" cy="145" r="8" fill="#ffd5e3"/>
</svg>
<h3>7. All Five Elements</h3>
</div>

</div>
</body>
</html>
